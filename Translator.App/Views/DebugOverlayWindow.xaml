<Window x:Class="Translator.App.Views.DebugOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DebugOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False">

    <!-- 调试覆盖层：显示 OCR 框、占用图、候选位置、流水线耗时 -->
    <Canvas x:Name="OverlayCanvas" Background="{x:Null}">

        <!-- 左下角的诊断面板 -->
        <Border x:Name="StatsPanel" Background="#CC000000" CornerRadius="6" Padding="10,8">
            <StackPanel>
                <TextBlock Text="调试覆盖层" Foreground="#FF80FF80" FontSize="11"
                           FontFamily="Consolas, Microsoft YaHei UI" FontWeight="Bold"/>
                <TextBlock x:Name="StatsText" Foreground="#FFDDDDDD" FontSize="11"
                           FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 图例 -->
        <Border x:Name="LegendPanel" Background="#CC000000" CornerRadius="6" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Rectangle Width="10" Height="10" Fill="#FF00FF00" VerticalAlignment="Center"/>
                    <TextBlock Text=" OCR 行框" Foreground="#FFDDDDDD" FontSize="10"
                               FontFamily="Consolas, Microsoft YaHei UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Rectangle Width="10" Height="10" Fill="#FFFF8800" VerticalAlignment="Center"/>
                    <TextBlock Text=" 段落框" Foreground="#FFDDDDDD" FontSize="10"
                               FontFamily="Consolas, Microsoft YaHei UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Rectangle Width="10" Height="10" Fill="#FF00AAFF" VerticalAlignment="Center"/>
                    <TextBlock Text=" 气泡落点" Foreground="#FFDDDDDD" FontSize="10"
                               FontFamily="Consolas, Microsoft YaHei UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="10" Height="10" Fill="#FF4444FF" VerticalAlignment="Center"/>
                    <TextBlock Text=" 占用区" Foreground="#FFDDDDDD" FontSize="10"
                               FontFamily="Consolas, Microsoft YaHei UI"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
