<Window x:Class="Translator.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 屏幕翻译" Height="620" Width="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="#FAFAFA">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="18" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 翻译 -->
                <GroupBox Header="翻译">
                    <StackPanel>
                        <TextBlock Text="目标语言" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="TargetLanguageBox" Width="220" HorizontalAlignment="Left">
                            <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                            <ComboBoxItem Content="繁體中文" Tag="zh-Hant"/>
                        </ComboBox>

                        <TextBlock Text="默认领域（术语库作用域）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="DomainBox" Width="220" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="AutoTranslateBox" Content="画面变化时自动翻译"/>
                        <CheckBox x:Name="OfflineOnlyBox" Content="仅使用离线模型（推荐）"/>

                        <TextBlock Text="防抖延迟（毫秒）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <Slider x:Name="DebounceSlider" Minimum="100" Maximum="1500" Width="260"
                                HorizontalAlignment="Left" TickFrequency="100" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- 气泡 -->
                <GroupBox Header="气泡外观">
                    <StackPanel>
                        <TextBlock Text="字号" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="20" Width="260"
                                HorizontalAlignment="Left" TickFrequency="1" IsSnapToTickEnabled="True"/>

                        <TextBlock Text="透明度" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Width="260"
                                HorizontalAlignment="Left" TickFrequency="0.05"/>

                        <TextBlock Text="气泡宽度系数" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <Slider x:Name="WidthFactorSlider" Minimum="0.5" Maximum="2.0" Width="260"
                                HorizontalAlignment="Left" TickFrequency="0.1"/>

                        <CheckBox x:Name="DarkModeBox" Content="跟随系统深浅色"/>
                        <CheckBox x:Name="SourceIndicatorBox" Content="显示原文关联指示"/>
                    </StackPanel>
                </GroupBox>

                <!-- 快捷键 -->
                <GroupBox Header="快捷键">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="框选工作区" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="HotkeyCaptureBox" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="开始 / 暂停" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="HotkeyPauseBox" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="全部折叠 / 展开" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="HotkeyCollapseBox" Margin="0,3"/>
                    </Grid>
                </GroupBox>

                <!-- 隐私 -->
                <GroupBox Header="隐私">
                    <StackPanel>
                        <CheckBox x:Name="PauseOnSensitiveBox" Content="前台是敏感窗口时自动暂停"/>
                        <CheckBox x:Name="LogSourceTextBox" Content="在日志中记录原文（默认关闭）"/>

                        <TextBlock Text="敏感窗口进程名黑名单（每行一个）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <TextBox x:Name="BlacklistBox" AcceptsReturn="True" Height="90"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button x:Name="ClearCacheButton" Content="清除翻译缓存" Margin="0,10,0,0"
                                Padding="12,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>

                <!-- 高级 -->
                <GroupBox Header="高级">
                    <StackPanel>
                        <CheckBox x:Name="RemoteBackendBox" Content="使用远程后端（[OI] 兼容接口）"/>
                        <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" Margin="0,8,0,4"/>
                        <TextBox x:Name="RemoteEndpointBox" Margin="0,0,0,6"/>
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="RemoteKeyBox" Margin="0,0,0,6"/>
                        <TextBlock Text="模型名" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RemoteModelBox"/>
                    </StackPanel>
                </GroupBox>

                <!-- 诊断 -->
                <GroupBox Header="诊断">
                    <StackPanel>
                        <TextBlock x:Name="DiagnosticsText" FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="11" Foreground="#555555" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Width="88" Padding="0,6" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="SaveButton" Content="保存" Width="88" Padding="0,6" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
