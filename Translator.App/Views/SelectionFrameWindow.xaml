<Window x:Class="Translator.App.Views.SelectionFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranslatorSelectionFrame"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Focusable="False"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- 翻译范围：只画一圈高亮边框，不压暗屏幕、不挡鼠标、不进截图 -->
        <Border x:Name="FrameBorder"
                BorderThickness="2"
                CornerRadius="4"
                BorderBrush="#FF3B9EFF"
                Background="#0A3B9EFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.6" Color="#FF3B9EFF"/>
            </Border.Effect>
        </Border>

        <!-- 左上角小标签，贴在框内侧 -->
        <Border x:Name="FrameLabel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="4"
                CornerRadius="3"
                Background="#CC1C1C1E"
                Padding="6,2">
            <TextBlock x:Name="LabelText"
                       FontFamily="Microsoft YaHei UI, Segoe UI"
                       FontSize="11"
                       Foreground="#FF7FC4FF"
                       Text="翻译范围" />
        </Border>
    </Grid>
</Window>
