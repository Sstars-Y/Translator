<Window x:Class="Translator.App.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegionSelector"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Cursor="Cross"
        KeyDown="OnKeyDown">

    <Canvas x:Name="RootCanvas" Background="#66000000">

        <!-- 已选区域的高亮边框 -->
        <Rectangle x:Name="SelectionRect" Stroke="#FF4C9AFF" StrokeThickness="2"
                   Fill="#2200AAFF" Visibility="Collapsed"/>

        <!-- 尺寸提示 -->
        <Border x:Name="SizeLabel" Background="#CC000000" CornerRadius="4"
                Padding="8,3" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"
                       FontFamily="Consolas, Microsoft YaHei UI"/>
        </Border>

        <!-- 操作提示 -->
        <Border x:Name="HintLabel" Background="#CC000000" CornerRadius="6" Padding="14,8">
            <StackPanel>
                <TextBlock Text="拖动鼠标框选要翻译的区域" Foreground="White"
                           FontSize="14" FontFamily="Microsoft YaHei UI"/>
                <TextBlock Text="Esc 取消   ·   松开鼠标确认" Foreground="#AAFFFFFF"
                           FontSize="11" FontFamily="Microsoft YaHei UI" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
